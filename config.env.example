# Copie para config.env e edite só o PROJECT_ID.
# Todo passo do tutorial começa com `source config.env`, então se o terminal
# (ou o Cloud Shell) reiniciar, nada se perde.

export PROJECT_ID="seu-projeto"
export REGION="us-central1"

# Modelo Gemini no Vertex AI. "global" tem os modelos mais novos.
# O passo 5 confere se essa combinação funciona no seu projeto.
export GEMINI_MODEL="gemini-3.1-flash-lite"
export GEMINI_LOCATION="global"

# Daqui para baixo não precisa mexer
export IMAGE="${REGION}-docker.pkg.dev/${PROJECT_ID}/nasa-agents/nasa-agents:v1"
export TF_VAR_project_id="$PROJECT_ID"
export TF_VAR_region="$REGION"
gcloud config set project "$PROJECT_ID" >/dev/null 2>&1
